<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.RiftTracker.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/rankHistoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RiftTracker.BodySmall"
            tools:text="Ranked Solo/Duo" />

        <com.veronezzi.riftlog.ui.profile.RankHistoryChartView
            android:id="@+id/rankHistoryChart"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/rankHistoryEmptyText"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.RiftTracker.BodySmall"
            android:textColor="@color/rift_on_surface_muted"
            android:visibility="gone"
            tools:text="Not enough data yet" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
