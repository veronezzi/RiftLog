<?xml version="1.0" encoding="utf-8"?>
<!-- Local stand-in for the design system's view_stat_card.xml (not shipped in v1.0.1). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    style="@style/Widget.RiftTracker.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/spacing_md">

        <TextView
            android:id="@+id/statValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RiftTracker.StatValue"
            tools:text="57%" />

        <TextView
            android:id="@+id/statLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:textAppearance="@style/TextAppearance.RiftTracker.LabelUppercase"
            tools:text="Winrate" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
