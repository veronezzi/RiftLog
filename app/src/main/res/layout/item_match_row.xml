<?xml version="1.0" encoding="utf-8"?>
<!-- Wraps the library's match-history-row component (view_match_history_item); the app just
     adds a bottom margin between rows and sets the win/loss stroke color at runtime in
     MatchAdapter, since the result is match data, not a design token (see the comment inside
     view_match_history_item.xml itself). Tapping a row now navigates to the full match-detail
     screen instead of expanding inline. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm">

    <include
        android:id="@+id/matchHistoryItem"
        layout="@layout/view_match_history_item" />
</FrameLayout>
